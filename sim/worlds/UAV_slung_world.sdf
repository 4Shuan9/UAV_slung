<?xml version="1.0"?>
<!-- Codex-generated final football and origin helipad integration; source flight configuration retained. -->
<sdf version="1.9">
  <world name="UAV_slung_world">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact" />
    <plugin filename="gz-sim-wind-effects-system" name="gz::sim::systems::WindEffects">
      <force_approximation_scaling_factor>1</force_approximation_scaling_factor>
      <linear_velocity>0 0 0</linear_velocity>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="libslung_magnetometer_system.so" name="slung_ctrl::MagnetometerSystem" />
    <plugin filename="gz-sim-altimeter-system" name="gz::sim::systems::Altimeter" />
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat" />
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure" />
    <physics type="ode">
      <max_step_size>0.0025</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>400</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.81</gravity>
    <magnetic_field>-2.9037200468e-06 3.69207212335e-05 -2.76691811238e-05</magnetic_field>
    <atmosphere type="adiabatic" />
    <scene>
      <grid>false</grid>
      <ambient>.40 .41 .42 1</ambient>
      <background>.62 .65 .68 1</background>
      <shadows>true</shadows>
    </scene>
    <!-- Codex-generated: finite circular ground, centered on the football field. -->
    <include>
      <name>ground_plane</name>
      <uri>model://stadium_ground</uri>
      <pose>54 0 0 0 0 0</pose>
    </include>
    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>.70</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>.75 .74 .70 1</diffuse>
      <specular>.03 .03 .03 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
    </light>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>24.623911</latitude_deg>
      <longitude_deg>118.087898</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
    <include>
      <name>football_field</name>
      <uri>model://football_field</uri>
      <pose>54 0 .03 0 0 -1.5707963267948966</pose>
    </include>
    <include>
      <name>payload_ball</name>
      <pose>1 0 3.572 0 0 0</pose>
      <uri>model://payload_ball</uri>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_sensor_pose>false</publish_sensor_pose>
        <publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
        <update_frequency>200</update_frequency>
      </plugin>
    </include>
    <include>
      <name>rope</name>
      <pose>1 0 3.572 0 0 3.14159</pose>
      <uri>model://rope</uri>
    </include>
    <include>
      <name>x500_mono_cam_down</name>
      <pose>0 0 3.572 0 0 0</pose>
      <uri>model://x500_mono_cam_down</uri>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_sensor_pose>false</publish_sensor_pose>
        <publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
        <update_frequency>200</update_frequency>
      </plugin>
    </include>
    <joint name="uav_rope_joint" type="fixed">
      <parent>rope::end_link</parent>
      <child>x500_mono_cam_down::base_link</child>
    </joint>
    <joint name="ball_rope_joint" type="fixed">
      <parent>payload_ball::ball_link</parent>
      <child>rope::begin_link</child>
    </joint>
    <include>
      <name>helipad</name>
      <uri>model://helipad</uri>
      <pose>0 0 0 0 0 -1.5707963267948966</pose>
    </include>
  </world>
</sdf>